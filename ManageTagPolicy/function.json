{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "Request",
      "methods": [
        "get",
        "put"
      ],
      "route": "management/tag-policy"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "Response"
    },
    {
      "type": "blob",
      "direction": "in",
      "name": "TagPolicyBlob",
      "path": "configuration/tag-authorization-policy.json",
      "connection": "AzureWebJobsStorage"
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "UpdatedTagPolicyBlob",
      "path": "configuration/tag-authorization-policy.json",
      "connection": "AzureWebJobsStorage"
    }
  ]
}